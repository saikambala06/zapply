# ============ REQUIRED ============

# MongoDB Atlas connection string.
# Free M0 cluster works. Under Network Access allow 0.0.0.0/0 so Vercel's
# functions can connect — this is the most common first-deploy failure.
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/zapply?retryWrites=true&w=majority"

# Session signing key. Generate with:  openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# Public URL, no trailing slash. Used for OAuth redirects, reset links and
# Stripe return URLs — set this correctly in production or those will break.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ============ OPTIONAL ============
# Every block below degrades gracefully when left blank.

# ---- AI (Premium: profile scoring, drafted answers, resume parsing) ----
# Groq. Free tier, no credit card: https://console.groq.com
# Without it: scoring falls back to keyword overlap; drafting and resume
# parsing return a clear "not configured" message instead of failing oddly.
GROQ_API_KEY=""

# The AI layer speaks plain OpenAI-compatible /chat/completions, so these two
# variables point it at any other provider without code changes. Leave blank
# for Groq's defaults.
#
#   Groq (default)  https://api.groq.com/openai/v1   openai/gpt-oss-120b
#   xAI (Grok)      https://api.x.ai/v1              grok-4
#   OpenAI          https://api.openai.com/v1        gpt-4o-mini
#   OpenRouter      https://openrouter.ai/api/v1     any routed model
#   Ollama (local)  http://localhost:11434/v1        llama3.1
#
# When pointing elsewhere, put that provider's key in AI_API_KEY instead of
# GROQ_API_KEY so the variable name isn't misleading.
AI_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# ---- Billing ----
# Without these: upgrading marks the account Premium directly so the whole
# Premium flow stays testable. Never ship to production without them.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# ---- Google sign-in ----
# Authorised redirect URI must be exactly:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Without these: the "Continue with Google" button returns a clear error.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Transactional email (password reset, email confirmation) ----
# Without a key: the message is logged server-side and, in development only,
# the reset link is returned to the browser so you can finish the flow.
RESEND_API_KEY=""
EMAIL_FROM="Zapply <onboarding@resend.dev>"
