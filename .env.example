# ============ REQUIRED ============
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/zapply?retryWrites=true&w=majority"
JWT_SECRET="replace-me-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============ AI ============
# Primary text AI provider. Used for normal PDF/DOCX resume parsing, scoring and answers.
GROQ_API_KEY=""

# Gemini OCR/vision provider. Used only for scanned/image-only resumes and legacy .DOC files.
# This project uses GOOGLE_API_KEY; GEMINI_API_KEY is not required.
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional OpenAI-compatible override for the text provider. Leave blank for Groq.
AI_BASE_URL=""
AI_MODEL=""

# ============ BILLING ============
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# ============ GOOGLE SIGN-IN ============
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============ EMAIL ============
RESEND_API_KEY=""
EMAIL_FROM="Zapply <onboarding@resend.dev>"
